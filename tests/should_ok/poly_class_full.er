# 目標: ユーザー定義の多相クラスの完全な実装
# このファイルが正常にコンパイル・実行できることが目標

# === Phase 1: 基本的な多相クラス定義 ===
Empty|T| = Class()
_ = Empty

# === Phase 2: フィールドを持つ多相クラス ===
# 型パラメータTを使用するフィールドを持つクラス
Box|T| = Class { .value = T }

# === Phase 3: 多相クラスのメソッド定義 ===
Box(T).
    get(self): T = self.value

# === Phase 4: 型推論によるインスタンス化 ===
int_box = Box.new { .value = 42 }

# === Phase 5: メソッド呼び出し ===
x = int_box.get()
assert x == 42

# === Phase 6: 非公開フィールド + 型注釈による型指定 ===
Wrapper|T| = Class { value = T }
Wrapper(T).
    unwrap(self): T = self::value
w: Wrapper(Int) = Wrapper.new { value = 1 }
assert w.unwrap() == 1

# === Phase 7: 複数型パラメータ ===
Pair|T, U| = Class { first = T; second = U }
Pair(T, U).
    fst(self): T = self::first
    snd(self): U = self::second
pair = Pair.new { first = 1; second = "a" }
assert pair.fst() == 1
assert pair.snd() == "a"

# === Phase 8: parameter syntax `C T = Class ...` ===
Packet T = Class { .payload = T }
Packet.
    get(self): T = self.payload
p = Packet.new { .payload = 7 }
assert p.get() == 7

# multiple parameters
Pair2 T, U = Class { .left = T; .right = U }
Pair2.
    fst(self): T = self.left
    snd(self): U = self.right
pair2 = Pair2.new { .left = 1; .right = "a" }
assert pair2.fst() == 1
assert pair2.snd() == "a"

print! "All polymorphic class tests passed!"
