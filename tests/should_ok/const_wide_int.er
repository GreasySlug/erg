# Constant folding must not be limited to `Int` (an `i32`): results that only fit
# `Nat` have to be folded exactly rather than truncated or rejected.
#
# This file is only compiled, not executed: integer literals above `i32` are not
# emitted correctly yet, so the folded values cannot be compared at run time.
# The singleton type ascriptions below check them at compile time instead.
WideSub: {9999999999} = 10000000000 - 1
WideAdd: {10000000000} = 5000000000 + 5000000000
WideMul: {10000000000} = 100000 * 100000
WideFloorDiv: {3333333333} = 10000000000 // 3
WideMod: {1} = 10000000000 % 3
WidePow: {4294967296} = 2 ** 32
WideShl: {1099511627776} = 1 << 40
IntStr: {10000000000} = int "10000000000"
NatStr: {10000000000} = nat "10000000000"
