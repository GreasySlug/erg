# available only if the ndbm library is installed
.Error = 'error': ClassType
.Error <: OSError

.library: Str

# `dbm.ndbm` does not expose the database class itself, so it is module-private here
Ndbm! : ClassType
Ndbm! <: ContextManager
Ndbm!.
    keys!: (self: Ref(Ndbm!)) => [Bytes; _]
    get!: (self: Ref(Ndbm!), key: Str or Bytes, default := Bytes or NoneType) => Bytes or NoneType
    setdefault!: (self: RefMut(Ndbm!), key: Str or Bytes, default := Bytes) => Bytes
    close!: (self: RefMut(Ndbm!)) => NoneType

.open!: (filename: PathLike, flag := Str, mode := Nat) => Ndbm!
