.CLOCK_BOOTTIME: Nat
.CLOCK_MONOTONIC: Nat
.CLOCK_MONOTONIC_RAW: Nat
.CLOCK_PROCESS_CPUTIME_ID: Nat
.CLOCK_PROF: Nat # FreeBSD/NetBSD only
.CLOCK_REALTIME: Nat
.CLOCK_TAI: Nat
.CLOCK_THREAD_CPUTIME_ID: Nat

.altzone: Int
.daylight: Int
.timezone: Int
.tzname: (Str, Str)

.asctime!: (tm := StructTime) => Str
.clock_getres!: (clock_id: Nat) => Float
.get_clock_info!: (name: Str) => NamedTuple {
    .adjustable = Bool;
    .implementation = Str;
    .monotonic = Bool;
    .resolution = Float;
}
.pthread_getcpuclockid!: (thread_id: Nat) => Nat
.clock_gettime!: (clock_id: Nat) => Float
.clock_gettime_ns!: (clock_id: Nat) => Int
.clock_settime!: (clock_id: Nat, time: Ratio or Float) => NoneType
.clock_settime_ns!: (clock_id: Nat, time: Int) => NoneType
.ctime!: (secs := Ratio or Float) => Str
.gmtime!: (secs := Ratio or Float) => StructTime
.localtime!: (secs := Ratio or Float) => StructTime
.mktime!: (tm: StructTime) => Float
.monotonic!: () => Float
.monotonic_ns!: () => Int
.perf_counter!: () => Float
.perf_counter_ns!: () => Int
.process_time!: () => Float
.process_time_ns!: () => Int
.sleep!: (Ratio or Float) => NoneType
.strftime!: (format: Str, tm := StructTime) => Str
.strptime!: (string: Str, format := Str) => StructTime
.time!: () => Float
.time_ns!: () => Int
.thread_time!: () => Float
.thread_time_ns!: () => Int
.tzset!: () => NoneType

.StructTime = 'struct_time': ClassType
.StructTime.
    tm_year: Nat
    tm_mon: Nat
    tm_mday: Nat
    tm_hour: Nat
    tm_min: Nat
    tm_sec: Nat
    tm_wday: Nat
    tm_yday: Nat
    tm_isdst: Nat
    tm_zone: Str
    tm_gmtoff: Nat
