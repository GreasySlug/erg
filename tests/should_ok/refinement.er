_: {I: Int | I <= 5} = 4
_: {I: Int | I < 5} = 4
_: {I: Int | I < 5 and I != 3} = 4
_: {I: Int | I < 5 or I != 3} = 4
_: {I: Int | I < 5 or I != 3 and I != 4} = 4

check _: {S: Str | S.replace("abc", "") == ""} = None
check "abc"

dic as Dict({{111}: {222}}) = {111: 222}
_: {222} = dic[111]

# refinement pattern: `X: T | Pred` == `X: {X: T | Pred}`
f(n: Nat | n >= 3) = n
_ = f 5
g = (n: Int | n >= 1) -> n + 1
_ = g 2
y: Int | y >= 3 = 5
assert y == 5

# refinement pattern with an omitted type: `X | Pred` == `{X: _ | Pred}`
m(l: List(Int, N | N >= 3)) = l
lis: List(Int, 3) = [1, 2, 3]
_ = m lis
_ = m [4, 5, 6, 7]

# set-builder notation binds a type like any other type expression
Positive = {I: Int | I >= 1}
_: Positive = 4
h(x: Positive): Int = x
_ = h 2
Small = {I: Int | I < 5 and I != 3}
_: Small = 4

# the predicate is run: a term over the refinement variable, and a call of a
# compile-time function, are computed once the variable is bound to a value
Odd = {N: Int | N % 2 == 1}
_: Odd = 3
o(x: Odd): Int = x
_ = o 5
_: {X: Int | X ** 2 - 5 * X + 6 == 0} = 2
IsOdd(N: Int): Bool = N % 2 == 1
_ = IsOdd 3
_: {N: Int | IsOdd(N)} = 7
