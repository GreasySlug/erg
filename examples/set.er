a = {1, 2, 3, 1, 2, 3} # {1, 2, 3} in no particular order
assert {1, 2, 3} == {1, 2, 3}
b = {"a", "a", "b", "b", "a", "b"} # {"a", "b"} in no particular order
assert {"a", "b"} == {"a", "b"}

c: {Int; _} = {-1, 1, -1, 1} # {-1, 1}

# Ratio (e.g. `1.0`) implements `Eq`, so a set of rationals is fine
assert {1.0, 1.0} == {1.0}

# If the object does not implement `Eq`, a compile error will occur
id = x -> x
print! {id, id} # compile error (subroutines do not implement `Eq`)
