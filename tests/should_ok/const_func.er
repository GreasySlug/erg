# Test for user-defined const functions (compile-time functions)

# Basic const function with two parameters
MyAdd(X, Y: Nat): Nat = X + Y
assert MyAdd(1, 2) == 3
assert MyAdd(10, 20) == 30

# Single parameter const function
MyDouble(X: Nat): Nat = X * 2
assert MyDouble(5) == 10
assert MyDouble(0) == 0

# Const function with subtraction
MySub(X, Y: Nat): Nat = X - Y
assert MySub(10, 3) == 7

# Const function returning a computed value
MySquare(X: Nat): Nat = X * X
assert MySquare(4) == 16
assert MySquare(3) == 9

# `if` is a compile-time function (both branches must themselves be const)
Then = if True, do 1, do 0
assert Then == 1
Else = if False, do 1, do 0
assert Else == 0
NoElse = if False, do 1
assert NoElse == None

Choose(C, A, B: Int): Int = if C, do A, do B
assert Choose(True, 10, 20) == 10
assert Choose(False, 10, 20) == 20

# Default parameters
Inc(X: Int, D := 1): Int = X + D
assert Inc(5) == 6
assert Inc(5, 3) == 8
assert Inc(X:=5, D:=4) == 9

# `in` / `notin` at compile time (uppercase binding forces const-eval)
InInt = 1 in Int
assert InInt
InList = 1 in [1, 2]
assert InList
InTuple = 1 in (1, 2)
assert InTuple
InSet = 1 in {1, 2}
assert InSet
InDict = 1 in {1: 2}
assert InDict
InRange = 1 in 1..2
assert InRange
NotInNat = -1 in Nat
assert not NotInNat
NotInList = -1 notin [1, 2]
assert NotInList

# Builtin compile-time functions (uppercase bindings force const-eval, and the
# folded value must agree with what the function returns at runtime)
IntStr = int "10"
assert IntStr == 10
IntTrunc = int 3.7
assert IntTrunc == 3
IntTruncNeg = int -3.7
assert IntTruncNeg == -3
IntBool = int True
assert IntBool == 1
NatOf = nat 5
assert NatOf == 5
FloatOf = float "2.5"
assert FloatOf.nearly_eq(float 2.5)
# ties round to even, as in Python
Round25 = round (float 2.5)
assert Round25 == 2
Round15 = round (float 1.5)
assert Round15 == 2
Round24 = round (float 2.4)
assert Round24 == 2
RoundNeg = round (float -1.5)
assert RoundNeg == -2
OrdA = ord "a"
assert OrdA == 97
ChrA = chr 97
assert ChrA == "a"
Hex = hex 255
assert Hex == "0xff"
HexNeg = hex -255
assert HexNeg == "-0xff"
Bin = bin 5
assert Bin == "0b101"
Oct = oct 8
assert Oct == "0o10"
Pow = pow 2, 10
assert Pow == 1024
DivMod = divmod 7, 2
assert DivMod == (3, 1)
DivModNeg = divmod -7, 2
assert DivModNeg == (-4, 1)
Sorted = sorted [3, 1, 2]
assert Sorted == [1, 2, 3]
StrInt = str 1
assert StrInt == "1"
StrBool = str True
assert StrBool == "True"
StrStr = str "ab"
assert StrStr == "ab"

# NOTE: keyword arguments to builtin compile-time functions are covered by
# tests/should_ok/const_kw_args.er (they cannot be executed: CPython's `abs`,
# `len`, ... reject keyword arguments).

# `int` honours the `base` it declares (the runtime `int__` forwards it)
IntBase16 = int("ff", base := 16)
assert IntBase16 == 255
IntBase2 = int("101", base := 2)
assert IntBase2 == 5
# `obj` is a default parameter of `float`
FloatDefault = float()
assert FloatDefault.nearly_eq(float 0)
# `base` follows Python: 0 detects the prefix, and `0x`/`0o`/`0b` are accepted
IntBase0 = int("0x10", base := 0)
assert IntBase0 == 16
IntBasePrefixed = int("0xff", base := 16)
assert IntBasePrefixed == 255
IntSeparator = int "1_0"
assert IntSeparator == 10
# `_` digit separators are accepted by `float`, too
FloatSeparator = float "1_0.5"
assert FloatSeparator.nearly_eq(float "10.5")

# A constant defined in a const function's body, built from the parameters.
#
# Lowering registers the definitions of a body before lowering it, and a
# constant's body is evaluated there and then -- which cannot work for one built
# from a parameter, whose value belongs to a call. It reported `N is not
# defined` (while suggesting `N`, which is right there as a parameter).
WithLocal(N: Int): Int =
    Tmp = N + 1
    Tmp * 2
assert WithLocal(3) == 8
WithLocal3: {8} = WithLocal(3)
assert WithLocal3 == 8

Chained(N: Int): Int =
    Fst = N + 1
    Snd = Fst * 2
    Snd + 1
Chained3: {9} = Chained(3)
assert Chained3 == 9

# The same, from an `if` branch: the branch is a `do` block with no parameters
# of its own, and it is still the const function's parameters it reads.
InBranch(N: Int): Int =
    if N > 0:
        do:
            Tmp = N + 1
            Tmp
        do: 0
InBranch3: {4} = InBranch(3)
assert InBranch3 == 4
assert InBranch(-1) == 0

# A *subroutine* defined in a const function's body.
#
# The parameters used to be dropped on the way in: a const body is stored as a
# `ConstBlock`, whose `ConstDef` held only an identifier, so `Bump(M) = M + N`
# came back as `Bump = M + N` and was evaluated with `M` unbound -- even when it
# captured nothing.
#
# It reads the frame it is called from, which is the frame that defined it: the
# name cannot leave the body, so that frame is always still on the chain. That
# is the same thing the emitted Python closure reads.
Nest(N: Int): Int =
    Bump(M: Int): Int = M + N
    Bump(1) + Bump(2)
Nest3: {9} = Nest(3)
assert Nest3 == 9
# a second call must not reuse the first one's captures
Nest4: {11} = Nest(4)
assert Nest4 == 11
assert Nest(0) == 3

# capturing nothing is the same path, and used to fail the same way
Pure(N: Int): Int =
    Sq(M: Int): Int = M * M
    Sq(4) + N
Pure1: {17} = Pure(1)
assert Pure1 == 17
assert Pure(10) == 26

# A const function of no parameters is still a function: a call folds, the
# name does not. It used to be registered as the value of its body, with the
# type of that value on a name that codegen binds to a function -- so the
# program passed the checker and failed at run time.
Zero(): Int = 1
assert Zero() == 1
Zero1: {1} = Zero()
assert Zero1 == 1

# variadic parameters bind the rest of the arguments -- a list, as at run time
Count(*Xs: Int): Int = len Xs
assert Count() == 0
assert Count(1, 2, 3) == 3
Count3: {3} = Count(1, 2, 3)
assert Count3 == 3
Head(*Xs: Int): Int = Xs[0]
Head7: {7} = Head(7, 8)
assert Head7 == 7
Total(X: Int, *Xs: Int): Int = X + len Xs
assert Total(10, 1, 2) == 12

# a parameterless const function defined in a const function's body
Doubled(N: Int): Int =
    Inner(): Int = N * 2
    Inner() + 1
Doubled3: {7} = Doubled(3)
assert Doubled3 == 7

# an anonymous lambda is a const value: it can be bound to a name, passed to
# a const function, and called
Succ = (X: Int) -> X + 1
Succ1: {2} = Succ(1)
assert Succ1 == 2
Apply(F, X: Int): Int = F(X)
Applied: {3} = Apply((X: Int) -> X + 1, 2)
assert Applied == 3

# a constant of a class may be built from one defined above it in the same
# block, before the block is on the class
Cfg = Class {.v = Int}
Cfg.
    Base = 2
    Tripled = Cfg.Base * 3
Tripled6: {6} = Cfg.Tripled
assert Tripled6 == 6

# a const function's body binds locals of any name -- and so what a pattern
# definition desugars to
Sum2(T: (Int, Int)): Int =
    (a, b) = T
    a + b
Sum3: {3} = Sum2((1, 2))
assert Sum3 == 3
Low(N: Int): Int =
    m = N + 1
    m * 2
Low4: {4} = Low(1)
assert Low4 == 4
