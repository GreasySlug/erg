Invert = Patch Bool
Invert::
    _zero = False
    _invert self = not self
Invert.
    zero = Invert::_zero
    invert self = self::_invert()

assert False.invert()

.ToLower = Patch Str
.ToLower::
    _lowers = "abcdefghijklmnopqrstuvwxyz"
    _to_lowercase self = self.lower()
.ToLower.
    lowers = .ToLower::_lowers
    to_lowercase self = self::_to_lowercase()

print! "".lowers
print! "AAA".to_lowercase()

# A patch on a user-defined class, not only on a builtin one
Point = Class {.x = Int; .y = Int}
Shift = Patch Point
Shift.
    shifted self, d: Int = Point.new {.x = self.x + d; .y = self.y + d}
    norm1 self = self.x.abs() + self.y.abs()

p = Point.new {.x = 1; .y = -2}
assert p.norm1() == 3
assert p.shifted(2).norm1() == 3
