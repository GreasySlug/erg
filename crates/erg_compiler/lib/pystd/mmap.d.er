.ACCESS_DEFAULT: Nat
.ACCESS_READ: Nat
.ACCESS_WRITE: Nat
.ACCESS_COPY: Nat
.ALLOCATIONGRANULARITY: Nat
.PAGESIZE: Nat

.PROT_EXEC: Nat # unix only
.PROT_READ: Nat # unix only
.PROT_WRITE: Nat # unix only

.MAP_ANON: Nat # unix only
.MAP_ANONYMOUS: Nat # unix only
.MAP_PRIVATE: Nat # unix only
.MAP_SHARED: Nat # unix only
.MAP_DENYWRITE: Nat # linux only
.MAP_EXECUTABLE: Nat # linux only
.MAP_NORESERVE: Nat # linux only
.MAP_POPULATE: Nat # linux only
.MAP_STACK: Nat # linux only

.MADV_NORMAL: Nat # unix only
.MADV_RANDOM: Nat # unix only
.MADV_SEQUENTIAL: Nat # unix only
.MADV_WILLNEED: Nat # unix only
.MADV_DONTNEED: Nat # unix only
