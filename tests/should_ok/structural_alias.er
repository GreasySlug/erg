# `Structural T` is a runtime wrapper around `T`, so two aliases of the
# same structure compare equal and `in` treats class instances structurally.

SNamed = Structural {.name = Str}
name x: SNamed = x.name

C = Class {.name = Str}
C.
    new name = C {.name = name}

assert name(C.new "erg") == "erg"

# structuralization of a nominal trait
Countable = Trait { .count = Nat }
SCountable = Structural Countable

D = Class {.count = Nat}
D.
    new count = D {.count = count}

count x: SCountable = x.count
# D never declares that it implements Countable
assert count(D.new 5) == 5
