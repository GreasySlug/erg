# What nested functions close over.

# A nested function calling itself. Its own name is a variable of the
# enclosing frame, which it holds in its closure -- so the cell has to exist
# before the function does. Reading it from a slot nothing had stored to
# crashed the interpreter (3.12+, where LOAD_FAST no longer checks).
outer(n: Int): Int =
    down(m: Int): Int = if m <= 0, do 0, do down(m - 1) + 1
    down(3) + n
assert outer(10) == 13

# A variable passing through a function that never reads it. The one in
# between hands the cell on; it used to hand on a slot of its own that
# COPY_FREE_VARS had put the value somewhere else.
through(n: Int): Int =
    mid(a: Int): Int =
        inner(b: Int): Int = b + n
        inner(a)
    mid(1)
assert through(3) == 4

# Read where it passes through, and one level further. The cell used to be
# boxed a second time on the way.
both(n: Int): Int =
    mid(a: Int): Int =
        inner(b: Int): Int = b + n
        inner(a) + n
    mid(1)
assert both(3) == 7

# a nested function closed over by its sibling
pair(n: Int): Int =
    f(x: Int): Int = x + n
    g(y: Int): Int = f(y) * 2
    g(1)
assert pair(3) == 8

# recursion that also captures
count(n: Int): Int =
    go(m: Int): Int = if m >= n, do m, do go(m + 1)
    go(0)
assert count(5) == 5

# a local, bound before the function that reads it and read after
scaled(n: Int): Int =
    k = n + 1
    f(x: Int): Int = x * k
    f(2) + k
assert scaled(3) == 12

# a closure that leaves the function that made it
adder(n: Int): (Int -> Int) = (m: Int) -> m + n
add3 = adder 3
assert add3(4) == 7


# The body of a loop is called once per element, so a binding of the body's
# own -- its parameter, a local -- is fresh on every iteration, and a closure
# made in the body keeps that iteration's value. This holds whether codegen
# splices the body into the loop (it does not when a binding of the body is
# captured) or passes it to `for__` as a function.
adders!() =
    fs = ![]
    for! [1, 2, 3], i =>
        fs.push!((m: Int) -> m + i)
    fs
fs = adders!()
assert fs[0](10) == 11
last = fs.pop!()
assert last(10) == 13

adders2!() =
    fs = ![]
    body! = i => fs.push!((m: Int) -> m + i)
    for! [1, 2, 3], body!
    fs
gs = adders2!()
assert gs[0](10) == 11
last2 = gs.pop!()
assert last2(10) == 13

pairs!() =
    fs = ![]
    for! [1, 2], i =>
        for! [10, 20], j =>
            fs.push!(() -> i + j)
    fs
ps = pairs!()
assert ps[0]() == 11
last3 = ps.pop!()
assert last3() == 22

evens!() =
    fs = ![]
    for! [1, 2, 3, 4], i =>
        if! i % 2 == 0, do!:
            k = i * 10
            fs.push!(() -> k)
    fs
es = evens!()
assert es[0]() == 20
last4 = es.pop!()
assert last4() == 40

counters!() =
    fs = ![]
    n = !0
    while! do! n < 3, do!:
        n.inc!()
        k = n * 2
        fs.push!(() -> k)
    fs
cs = counters!()
assert cs[0]() == 2
last5 = cs.pop!()
assert last5() == 6

# A variable bound in a block codegen inlines -- a `match` arm, an `if`
# branch, a `with!` block -- is a local of the function the block is inlined
# into. Bound by name instead, it went to the module's globals (a function
# frame without CO_OPTIMIZED uses them as its locals), and every closure over
# it read whatever the last call had left there.
mk(x: Int): (() -> Int) =
    match x:
        n -> () -> n
one = mk 1
two = mk 2
assert one() == 1
assert two() == 2

mk2(x: Int): (() -> Int) =
    if x > 0:
        do:
            k = x + 10
            () -> k
        do: () -> 0
one2 = mk2 1
two2 = mk2 2
assert one2() == 11
assert two2() == 12

Box = Class {.v = Int}
Box|<: ContextManager|.
    __enter__ self = self
    __exit__ self, _, _, _ = False
mk3!(x: Int): (() -> Int) =
    with! Box.new({.v = x}), b =>
        () -> b.v
one3 = mk3! 1
two3 = mk3! 2
assert one3() == 1
assert two3() == 2
