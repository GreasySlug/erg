.dumb = pyimport "dumb"
.gnu = pyimport "gnu"
.ndbm = pyimport "ndbm"
.sqlite3 = pyimport "sqlite3"

{Dumbdbm!;} = pyimport "dumb"

.Error = 'error': ClassType
.Error <: Exception

.whichdb!: (filename: PathLike) => Str or NoneType
# the concrete class depends on which backend is available at runtime
.open!: (file: PathLike, flag := Str, mode := Nat) => Dumbdbm!
