# `f64` / `f32` literal suffix constructs a `Float` from a `Ratio`
# (decimal literals like `2.5` are `Ratio`; the suffix is how a `Float` is written)

a = 2.5f64           # Float (inferred)
b: Float = 1.0f64    # annotated Float
c: Float = (1/2)f64  # suffix on a parenthesized expression
d = 15f32            # f32 is also Float
g = (1 + 2)f64       # suffix on an arbitrary parenthesized expression

assert a > b
assert b > c
assert d > a
assert g > a

e = a + b
assert e > a
f = a * 2.0f64
assert f > e
print! "float ok"
