# A const function that cannot fold *this* call is not a missing feature: the
# call is well-formed and the program runs, only the value has no compile-time
# representation. These used to be reported as
# `FeatureError: int (out of range) is not supported yet in const context`.
BigInt = int("99999999999999999999999999999999999")   # ERR
BigPow = pow(2, 10000)                                # ERR
BigNat = nat("99999999999999999999999999999999999")   # ERR
Surrogate = chr(0xD800)                               # ERR
# `str` of a `Float` cannot reproduce CPython's shortest-repr rounding
FloatStr = str(float 1.5)                             # ERR
# a parameterized generic is not a runtime class: `isinstance` raises there
IsList = isinstance([1], List(Int))                   # ERR

# the same expressions are fine at run time
big_int = int("99999999999999999999999999999999999")
big_pow = pow(2, 10000)
print! big_int, big_pow

# The same, inside a subroutine. A constant in a *const* subroutine's body may
# be built from the parameters, so it is left to be evaluated per call -- but a
# plain function's parameters never have a compile-time value, so a constant
# there has to be reported here or nowhere.
plain(n: Int): Int =
    Tmp = n + 1                                       # ERR
    Tmp * 2
print! plain(1)

# `match` folds only when it can decide which arm runs. CPython holds
# `1 == True`, so a `Bool` against an `Int` pattern is not decidable here
# without repeating that; the arm's condition does not fold and the `match`
# declines rather than guess.
AmbiguousMatch = match True:                          # ERR
    1 -> "int one"
    True -> "bool true"
    _ -> "other"
