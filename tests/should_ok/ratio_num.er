# `abs`/`round`/`str` on a `Ratio` (a `fractions.Fraction` at run time).
# `abs` used to be declared `Num -> Nat`, so codegen wrapped it in `Nat(...)`
# and `abs(-1.5)` silently became 1.

assert abs(-1.5) == 1.5
assert abs(-0.25) == 0.25
assert abs(0.1 - 0.3) == 0.2
# the overload keeps `Float` for a `Float`, and an integer comes out as a
# `Ratio` (`Int <: Ratio`) -- `.abs()` is what narrows an `Int` to `Nat`
assert abs(-3) == 3
assert abs(float(-1.5)).nearly_eq float(1.5)
narrowed: Nat = (-3).abs()
assert narrowed == 3

# inside a lambda the argument's class is not known when `abs` is resolved, so
# the branch picked there must not be one whose return codegen wraps -- an
# `Int`/`Nat` return truncated the `Fraction` back to an integer
# (a `Float` argument reaches the same branch, so it comes out typed `Ratio`;
# the value is right, and a `Float`-only method on it is a compile error rather
# than a wrong answer.)
diff = (l, r) -> abs(l - r)
assert diff(1.5, 0.25) == 1.25

# through a function, where the argument's class comes from the annotation
f(x: Ratio) = abs x
assert f(-1.5) == 1.5
g(x: Int) = abs x
assert g(-3) == 3

# `.abs()` as a method, which `Ratio`/`Float` did not have at all
neg = -0.25
assert neg.abs() == 0.25
fneg = float(-1.5)
assert fneg.abs().nearly_eq float(1.5)

# `round` rejected `Ratio` outright (it was declared `Float -> Int`).
# CPython rounds halves to even, and does it exactly for a `Fraction`.
assert round(0.5) == 0
assert round(1.5) == 2
assert round(2.5) == 2
assert round(-0.5) == 0
assert round(-1.5) == -2
assert round(2 / 3) == 1
assert round(float(2.5)) == 2

# `str` of a `Ratio` is its `Fraction` form
assert str(1.5) == "3/2"
assert str(-1.5) == "-3/2"
assert str(3.0) == "3"

# the same values, folded at compile time (the annotations are singleton types,
# so they only check if the constant folded to exactly that value)
Abs: {1.5} = abs(-1.5)
AbsInt: {3} = abs(-3)
Rounded: {2} = round(1.5)
RoundedEven: {2} = round(2.5)
StrOf: {"3/2"} = str(1.5)
assert Abs == 1.5
assert AbsInt == 3
assert Rounded == 2
assert RoundedEven == 2
assert StrOf == "3/2"

# Unary `+`/`-`: `Ratio` implemented neither `Pos` nor `Neg`, so a value typed
# `Ratio` could not be negated at all (`Int` has them, but the impls do not
# travel up the hierarchy).
r = 0.1
negated = -r
assert negated == -0.1
plussed = +r
assert plussed == 0.1
third: Ratio = 1 / 3
neg_third = -third
assert neg_third == -1 / 3

# 2.5e-38 is 1/(4*10^37) and fits, but the denominator used to be built as
# 10^39 -- which does not -- before being reduced.
assert 2.5e-38 * 4 == 1e-37
# `round` compares against `den / 2`: `rest * 2` overflows once the denominator
# passes i128::MAX / 2, which 1e-38 already does
assert round(1 - 1e-38) == 1
assert round(0 - 1e-38) == 0

# A `Ratio` literal inside a function body: codegen imports `Fraction` lazily,
# and the flag saying it had been imported was shared across code objects -- so
# an import emitted inside this body counted for the module-level `0.5` below,
# which runs first and raised `NameError: ::#Fraction`.
scale(x: Ratio) = x * 0.5
assert scale(0.5) == 0.25

# A decimal whose exact rational does not fit `Ratio` is still a `Ratio`, and is
# built exactly from its source text -- it just cannot be a compile-time constant
# (see tests/should_err/const_op.er).
planck = 6.62607015e-34
typed: Ratio = planck
assert typed * 2 == 1.32521403e-33

# `Ratio!` had no run-time class at all: `!0.5` stayed an immutable `Fraction`,
# so even the `update!` it did declare raised AttributeError.
mut = !0.5
mut.inc! 1.0
assert mut == 1.5
mut.dec! 0.5
assert mut == 1.0
mut.update! old -> old * 3
assert mut == 3.0
# reflected operators: Python looks these up on the type, so `MutType`'s
# attribute fallback cannot stand in for them
assert 1.0 + mut == 4.0
assert 2 * mut == 6.0
copied = mut.copy()
copied.dec! 1.0
assert copied == 2.0
assert mut == 3.0

print! "OK"
