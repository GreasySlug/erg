l = [i | i <- 1..4]
assert l == [1, 2, 3, 4]
lc = [i * 2 | i <- 1..4]
assert lc == [2, 4, 6, 8]
lc2 = [i + 1 | i <- 1..5 | i <= 3]
assert lc2 == [2, 3, 4]
lc3 = [i <- 1..10 | i <= 5]
assert lc3 == [1, 2, 3, 4, 5]
lc4 = [i * 5 | i <- 1..15 | i <= 5]
assert lc4 == [5, 10, 15, 20, 25]

s = {i | i <- [1, 2, 1, 2]}
assert s == {1, 2}
sc = {i * 2 | i <- 1..4}
assert sc == {2, 4, 6, 8}
sc2 = {i + 1 | i <- 1..5 | i <= 3}
assert sc2 == {2, 3, 4}
sc3 = {i <- 1..10 | i <= 5}
assert sc3 == {1, 2, 3, 4, 5}
sc4 = {i % 5 | i <- 1..100 | i % 5 != 0}
assert sc4 == {1, 2, 3, 4}

d = {i: i * 2 | i <- [1, 2, 3]}
assert d == {1: 2, 2: 4, 3: 6}
dc = {i: i + 1 | i <- 1..5 | i <= 3}
assert dc == {1: 2, 2: 3, 3: 4}
dc2 = {i + 1: i * 2 | i <- 1..3}
assert dc2 == {2: 2, 3: 4, 4: 6}

t = (i | i <- 1..4)
assert t == (1, 2, 3, 4)
tc = (i * 2 | i <- 1..4)
assert tc == (2, 4, 6, 8)
tc2 = (i + 1 | i <- 1..5 | i <= 3)
assert tc2 == (2, 3, 4)
tc3 = (i <- 1..10 | i <= 5)
assert tc3 == (1, 2, 3, 4, 5)
tc4 = (i * 5 | i <- 1..15 | i <= 5)
assert tc4 == (5, 10, 15, 20, 25)

# multiple generators
m = [x * 10 + y | x <- [1, 2]; y <- [1, 2, 3]]
assert m == [11, 12, 13, 21, 22, 23]
mg = [x * 10 + y | x <- [1, 2, 3]; y <- [1, 2, 3] | x < y]
assert mg == [12, 13, 23]
m3 = [x + y + z | x <- [1, 2]; y <- [10, 20]; z <- [100, 200]]
assert m3 == [111, 211, 121, 221, 112, 212, 122, 222]
ms = {x + y | x <- [1, 2]; y <- [10, 20]}
assert ms == {11, 21, 12, 22}
mt = (x + y | x <- [1, 2]; y <- [10, 20])
assert mt == (11, 21, 12, 22)
md = {x: y | x <- [1, 2]; y <- [10, 20]}
assert md == {1: 20, 2: 20}

# nested comprehension
nested = [[y | y <- 1..x] | x <- [1, 2, 3]]
assert nested[0] == [1]
assert nested[1] == [1, 2]
assert nested[2] == [1, 2, 3]
