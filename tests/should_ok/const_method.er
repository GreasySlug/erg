# Const methods called on a *value* (not on the type).
#
# `eval_attr` only searched a class's const table when the receiver was a type,
# so every const method registered on a builtin class was unreachable as
# `value.method(...)` -- including the `__getitem__`s that subscripts desugar to.

# Str
assert "abc".replace("a", "z") == "zbc"
assert "abc".startswith("a")
assert "abc".endswith("c")
assert "abc".isalpha()
assert "abc".isascii()
assert "123".isdecimal()
assert "abc".find("b") == 1
assert ", ".join(["a", "b"]) == "a, b"

# Int
Neg3 = -3
assert Neg3.abs() == 3

# List
assert [1, 2].reversed() == [2, 1]

# subscripts (`x[i]` desugars to `x.__getitem__(i)`, `x.0` to `x.__Tuple_getitem__(0)`)
Lis = [1, 2, 3]
assert Lis[0] == 1
assert Lis[2] == 3
Nested = [[1, 2], [3, 4]]
assert Nested[0][1] == 2
Dic = {"a": 1}
assert Dic["a"] == 1
Tup = (1, "two")
assert Tup[0] == 1
assert Tup.0 == 1
assert Tup.1 == "two"
Stri = "abc"
assert Stri[0] == "a"
assert Stri[2] == "c"
Rng = 1..5
assert Rng[0] == 1

# A constant *of* a class, called through the class.
#
# The receiver used to be passed along as the first argument whichever way the
# attribute was found, so `C.Twice(3)` bound `N` to the class and folded to
# `<module>::C * 2`.
C = Class {}
C.
    Twice(N: Int): Int = N * 2
    Sq(N: Int): Int = N * N
Six: {6} = C.Twice(3)
assert Six == 6
assert C.Sq(7) == 49

# A class's own constants, read from a constant of that class.
#
# A frame used to be named after its subroutine alone, and a bare name is not a
# namespace: `get_mono_type` asks whether the current scope is inside the type's,
# so no class of the module was reachable from a const function's body.
D = Class {}
D.
    Base: Int = 10
    Add(N: Int): Int = D.Base + N
Thirteen: {13} = D.Add(3)
assert Thirteen == 13
# and from a constant that is not a method of it
Outside(N: Int): Int = D.Base + N
Eleven: {11} = Outside(1)
assert Eleven == 11
