.Error = 'error': ClassType
.Error <: OSError

.Mmap! = 'mmap': ClassType
.Mmap! <: ContextManager
.Mmap!.
    closed: Bool
    __call__: (
        fileno: Int,
        length: Nat,
        flags := Nat,
        prot := Nat,
        access := Nat,
        offset := Nat,
    ) -> .Mmap!
    close!: (self: RefMut(.Mmap!)) => NoneType
    find: (self: Ref(.Mmap!), sub: Bytes, start := Nat, end := Nat) -> Int
    rfind: (self: Ref(.Mmap!), sub: Bytes, start := Nat, end := Nat) -> Int
    flush!: (self: RefMut(.Mmap!), offset := Nat, size := Nat) => NoneType
    madvise!: (self: RefMut(.Mmap!), option: Nat, start := Nat, length := Nat) => NoneType
    move!: (self: RefMut(.Mmap!), dest: Nat, src: Nat, count: Nat) => NoneType
    read!: (self: RefMut(.Mmap!), n := Nat or NoneType) => Bytes
    read_byte!: (self: RefMut(.Mmap!)) => Nat
    readline!: (self: RefMut(.Mmap!)) => Bytes
    resize!: (self: RefMut(.Mmap!), newsize: Nat) => NoneType
    seek!: (self: RefMut(.Mmap!), pos: Int, whence := Nat) => NoneType
    seekable: (self: Ref(.Mmap!)) -> Bool
    size: (self: Ref(.Mmap!)) -> Nat
    tell: (self: Ref(.Mmap!)) -> Nat
    write!: (self: RefMut(.Mmap!), bytes: Bytes) => Nat
    write_byte!: (self: RefMut(.Mmap!), byte: Nat) => NoneType
