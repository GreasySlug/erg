p! *x: Int = print! x
p! 1, 2, 3

first *x = x[0]
assert first(1, 2, 3) == 1

sum_ start: Nat, *args: Int =
    sum(args, start:=start)
assert sum_(0, 1, 2, 3) == 6

f = (*_: Int) -> None
f(1, 2, 3)

_: Int -> NoneType = f
_: (Int, Int) -> NoneType = f
_: (Int, Nat) -> NoneType = f

# default param after var args
g *args: Int, start := 0 = args.sum() + start
assert g(1, 2, 3) == 6
assert g(1, 2, 3, start:=10) == 16

# method with var args
C = Class {x = Int}
C.
    total self, *args: Int = self::x + args.sum()
c = C.new {x = 10}
assert c.total(1, 2, 3) == 16

# calls with list expansion
xs = [1, 2, 3]
assert g(*xs) == 6
assert g(10, *xs) == 16
