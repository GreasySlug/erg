# Cyclic (infinitely recursive) constant definitions must be reported as errors,
# not crash the compiler with a stack overflow.

# self-recursive const function evaluated in a const context
F n = F n
X = F 1 # ERR

# mutually recursive const functions evaluated in a const context
G n = H n
H n = G n
Y = G 1 # ERR

# infinite recursion that goes through `if` (a compile-time function): the
# branches are `do` blocks, so this used to overflow the compiler's stack
Loop(N: Int): Int = if True, do Loop(N), do 0
Z = Loop 1 # ERR

print! X
print! Y
print! Z
