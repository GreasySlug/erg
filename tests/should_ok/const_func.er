# Test for user-defined const functions (compile-time functions)

# Basic const function with two parameters
MyAdd(X, Y: Nat): Nat = X + Y
assert MyAdd(1, 2) == 3
assert MyAdd(10, 20) == 30

# Single parameter const function
MyDouble(X: Nat): Nat = X * 2
assert MyDouble(5) == 10
assert MyDouble(0) == 0

# Const function with subtraction
MySub(X, Y: Nat): Nat = X - Y
assert MySub(10, 3) == 7

# Const function returning a computed value
MySquare(X: Nat): Nat = X * X
assert MySquare(4) == 16
assert MySquare(3) == 9

# `if` is a compile-time function (both branches must themselves be const)
Then = if True, do 1, do 0
assert Then == 1
Else = if False, do 1, do 0
assert Else == 0
NoElse = if False, do 1
assert NoElse == None

Choose(C, A, B: Int): Int = if C, do A, do B
assert Choose(True, 10, 20) == 10
assert Choose(False, 10, 20) == 20

# Default parameters
Inc(X: Int, D := 1): Int = X + D
assert Inc(5) == 6
assert Inc(5, 3) == 8
assert Inc(X:=5, D:=4) == 9

# `in` / `notin` at compile time (uppercase binding forces const-eval)
InInt = 1 in Int
assert InInt
InList = 1 in [1, 2]
assert InList
InTuple = 1 in (1, 2)
assert InTuple
InSet = 1 in {1, 2}
assert InSet
InDict = 1 in {1: 2}
assert InDict
InRange = 1 in 1..2
assert InRange
NotInNat = -1 in Nat
assert not NotInNat
NotInList = -1 notin [1, 2]
assert NotInList

# Builtin compile-time functions (uppercase bindings force const-eval, and the
# folded value must agree with what the function returns at runtime)
IntStr = int "10"
assert IntStr == 10
IntTrunc = int 3.7
assert IntTrunc == 3
IntTruncNeg = int -3.7
assert IntTruncNeg == -3
IntBool = int True
assert IntBool == 1
NatOf = nat 5
assert NatOf == 5
FloatOf = float "2.5"
assert FloatOf.nearly_eq(float 2.5)
# ties round to even, as in Python
Round25 = round (float 2.5)
assert Round25 == 2
Round15 = round (float 1.5)
assert Round15 == 2
Round24 = round (float 2.4)
assert Round24 == 2
RoundNeg = round (float -1.5)
assert RoundNeg == -2
OrdA = ord "a"
assert OrdA == 97
ChrA = chr 97
assert ChrA == "a"
Hex = hex 255
assert Hex == "0xff"
HexNeg = hex -255
assert HexNeg == "-0xff"
Bin = bin 5
assert Bin == "0b101"
Oct = oct 8
assert Oct == "0o10"
Pow = pow 2, 10
assert Pow == 1024
DivMod = divmod 7, 2
assert DivMod == (3, 1)
DivModNeg = divmod -7, 2
assert DivModNeg == (-4, 1)
Sorted = sorted [3, 1, 2]
assert Sorted == [1, 2, 3]
StrInt = str 1
assert StrInt == "1"
StrBool = str True
assert StrBool == "True"
StrStr = str "ab"
assert StrStr == "ab"

# NOTE: keyword arguments to builtin compile-time functions are covered by
# tests/should_ok/const_kw_args.er (they cannot be executed: CPython's `abs`,
# `len`, ... reject keyword arguments).

# `int` honours the `base` it declares (the runtime `int__` forwards it)
IntBase16 = int("ff", base := 16)
assert IntBase16 == 255
IntBase2 = int("101", base := 2)
assert IntBase2 == 5
# `obj` is a default parameter of `float`
FloatDefault = float()
assert FloatDefault.nearly_eq(float 0)
# `base` follows Python: 0 detects the prefix, and `0x`/`0o`/`0b` are accepted
IntBase0 = int("0x10", base := 0)
assert IntBase0 == 16
IntBasePrefixed = int("0xff", base := 16)
assert IntBasePrefixed == 255
IntSeparator = int "1_0"
assert IntSeparator == 10
# `_` digit separators are accepted by `float`, too
FloatSeparator = float "1_0.5"
assert FloatSeparator.nearly_eq(float "10.5")
