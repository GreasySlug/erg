# `Option` / `Result` aliases, including their runtime type values
a: Option Int = 1
assert a == 1
b: Option Int = None
assert b == None

opt(x: Int): Option Int = if x > 0, do x, do None
assert opt(3) == 3
assert opt(-3) == None

half(x: Int): Result Int = if x % 2 == 0, do x // 2, do Error "not even"
halved = half(8)
assert halved in Int
assert halved == 4
assert half(3) in Error

# `Either(L, R)` is the same alias machinery
pick(x: Int): Either(Int, Str) = if x > 0, do x, do "negative"
picked = pick(-1)
assert picked in Str
assert picked.upper() == "NEGATIVE"

# bound to a name, an alias is built at runtime
MyOpt = Option Str
m: MyOpt = "bound"
assert m == "bound"
MyEither = Either(Int, Str)
n: MyEither = 1
assert n == 1
