_: Bool = 0 # OK
_: Bool = 2 # ERR
_: {1, 2} = 2 # OK
_: {1, 3} = 4 # ERR
_: {4} = 3 - 2 # ERR
_: 1..10 = 1 # OK
_: 0..12 = 13 # ERR

_: {I: Int | I < 10 and I != 6} = 6 # ERR
_: {I: Int | I < 5} = 6 # ERR
_: {I: Int | I < 3 or I != 4} = 4 # ERR
_: {I: Int | (I < 5 or I != 3) and I != 4} = 4 # ERR

check _: {S: Str | S.replace("abc", "") == ""} = None
check "abcd" # ERR

dic as Dict({{111}: {222}}) = {111: 222}
_ = dic[333] # ERR

# refinement pattern
f(n: Nat | n >= 3) = n
_ = f 1 # ERR
m(l: List(Int, N | N >= 3)) = l
_ = m [1, 2] # ERR
z: Int | z >= 3 = 1 # ERR

# a named refinement type refines just as much as the one written in place
Positive = {I: Int | I >= 1}
_: Positive = 0 # ERR
h(x: Positive): Int = x
_ = h 0 # ERR

# the predicate is run, so what it rejects is an error
Odd = {N: Int | N % 2 == 1}
_: Odd = 4 # ERR
o(x: Odd): Int = x
_ = o 6 # ERR
_: {X: Int | X ** 2 - 5 * X + 6 == 0} = 5 # ERR
IsOdd(N: Int): Bool = N % 2 == 1
_ = IsOdd 3
_: {N: Int | IsOdd(N)} = 8 # ERR
